# Copia este archivo como .env y completa las credenciales de Wompi.
# Comienza SIEMPRE con llaves de pruebas (pub_test_ / test_integrity_ / test_events_).
WOMPI_PUBLIC_KEY=pub_test_REEMPLAZAR
WOMPI_INTEGRITY_SECRET=test_integrity_REEMPLAZAR
WOMPI_EVENTS_SECRET=test_events_REEMPLAZAR
# URL pública HTTPS de tu instalación. localhost no recibe webhooks.
GYMBOT_PUBLIC_BASE_URL=https://tu-dominio.com
# Precio en pesos colombianos (no centavos). Ejemplo: 65000 = $65.000 COP.
GYMBOT_MEMBERSHIP_PRICE_COP=0
GYMBOT_MEMBERSHIP_DAYS=30
# Genera un secreto largo aleatorio; mínimo 32 caracteres.
GYMBOT_SESSION_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO_LARGO
